{
  "name": "opencrowd",
  "version": "0.3.2",
  "description": "A CLI agent with its own wallet — discovers x402 services, pays in USDC, and completes tasks under a local budget",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sr33j/opencrowd.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/sr33j/opencrowd#readme",
  "bugs": {
    "url": "https://github.com/sr33j/opencrowd/issues"
  },
  "keywords": [
    "agent",
    "x402",
    "usdc",
    "mcp",
    "cli",
    "wallet",
    "base"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opencrowd": "bundle/opencrowd.js"
  },
  "files": [
    "bundle"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ink": "^7.0.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "venice-x402-client": "^0.2.0"
  },
  "devDependencies": {
    "@opencrowd/agent-runtime": "0.1.0",
    "@opencrowd/economy": "0.1.0",
    "@opencrowd/core": "0.1.0",
    "@opencrowd/evals": "0.1.0"
  },
  "scripts": {
    "build": "tsc -b && chmod +x dist/index.js",
    "bundle": "node ../../scripts/bundle-cli.mjs",
    "prepack": "npm --prefix ../.. run build && npm run bundle"
  }
}
